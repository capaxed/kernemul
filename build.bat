@echo off
rem x64/WHP build of the ported tree. Excluded: arm64 TUs, the vendor pe test main,
rem and unicorn_cpu_ident.cpp (the only unicorn-backend .cpp; this build has no unicorn).
rem Object names derive from full paths; the link is a wildcard over obj\ because the
rem directory is wiped and rebuilt from scratch every time, so no stale object can slip in.
setlocal
call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat" x64 >nul || exit /b 1
pushd "%~dp0"
if exist obj rmdir /s /q obj
mkdir obj
del /q build.log 2>nul
cl /nologo /std:c++latest /Zc:preprocessor /EHsc /O2 /bigobj /DKERNEMUL_ARCH_X64=1 /DKERNEMUL_HAS_WHP=1 /DNOMINMAX /I"shims" /I"src" /I"vendor\pe\src" /I"vendor\ia32-doc\out" /I"vendor\hypermulator\src" /c "shims\win_host_shims.cpp" /Fo"obj\shims_win_host_shims.obj" >> build.log 2>&1 || (echo COMPILE_FAIL shims\win_host_shims.cpp & exit /b 1)
